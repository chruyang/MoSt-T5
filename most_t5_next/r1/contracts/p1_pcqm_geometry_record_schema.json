          "coordinates",
          "coordinates_sha256",
          "e3fp",
          "e3fp_shape",
          "e3fp_params_sha256",
          "e3fp_sha256"
        ],
        "required_values": {
          "geometry_valid": true,
          "geometry_mse_enabled": false,
          "geometry_mse_candidate_after_tokenizer_binding": true
        },
        "value_constraints": [
          "geometry_mse_enabled remains false because this is a geometry-only pretokenizer record; it must not be sent to a P1 loss.",
          "coordinates obey array_contracts.coordinates",
          "e3fp obeys array_contracts.e3fp",
          "e3fp_shape equals [model_atom_count, 4]",
          "motif_geometry_valid obeys array_contracts.motif_geometry_valid"
        ]
      },
      "array_metadata": {
        "required_fields": [
          "coordinates_dtype",
          "coordinates_shape",
          "coordinates_order",
          "e3fp_dtype",
          "e3fp_shape",
          "e3fp_order",
