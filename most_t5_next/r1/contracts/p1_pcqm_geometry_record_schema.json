{
  "schema_version": "most-t5-r1/p1-pcqm-geometry-record-schema-contract/v2",
  "logical_geometry_record_schema_version": "most-t5-r1/p1-pcqm-geometry-pretokenizer-record/v2",
  "purpose": "Machine-readable contract for a bounded PCQM4Mv2 P1 geometry-only pretokenizer sidecar smoke v2. It defines a recursively closed, non-executable admitted record, its ordinal membership row, and the one-to-one reject ledger. It is not a tokenizer-bound training record, a training-data admission, or a full-corpus release schema.",
  "scope": {
    "source_profile": "pcqm4mv2_candidate",
    "identity_namespace": "ogb_pcqm4mv2_train_row_index",
    "source_record_count": 3378606,
    "sidecar_mode": "bounded_smoke_only",
    "maximum_selected_source_records": 1000,
    "p1_training_admission": false,
    "p1_training_launcher_permitted": false,
    "tokenizer_binding_permitted_in_this_schema": false,
    "member_id_format": "ogb_pcqm4mv2_train_row_index:<zero-based decimal SDF ordinal>",
    "storage_key_format": "zero-padded nine-digit decimal SDF ordinal",
    "ordinal_selection_rule": "The smoke descriptor must name a deterministic, duplicate-free, ascending SDF-ordinal selection and its SHA-256. Every selected ordinal must have exactly one membership row."
  },
  "source_and_adapter_bindings": {
    "required_source_locks": [
      "p1_membership_source",
      "p1_geometry_source",
      "p1_adapter_harness",
      "p1_record_schema",
      "p1_geometry_payload_format",
      "pcqm_identity_normalization_contract"
    ],
    "required_contract_hashes": {
      "identity_normalization_contract_sha256": "SHA-256 of pcqm4mv2_identity_normalization_contract.json",
      "source_contract_sha256": "SHA-256 of the immutable PCQM source contract including the locked inner SDF member",
      "hydrogen_projection_spec_sha256": "SHA-256 of the frozen minimal RemoveHs projection specification",
      "linearizer_spec_sha256": "SHA-256 of the isolated linearize_mol harness/specification",
      "e3fp_params_sha256": "SHA-256 of the resolved E3FP parameter specification",
      "tokenizer_contract_sha256": "SHA-256 of the frozen tokenizer contract; it may be unavailable for a pre-tokenizer smoke, in which case the record cannot be passed to training"
    },
    "same_mol_derivation": "single_post_projection_geometry_mol",
    "source_atom_index_tag": "_r1_source_atom_index",
    "source_atom_index_tagged_pre_removehs": true,
    "compacted_index_inference_forbidden": true,
    "smiles_rebuild_for_alignment_forbidden": true,
    "frozen_mol_linearizer_required": true,
    "geometry_only_pretokenizer_record_non_admissible": true,
    "future_tokenizer_bound_mask_contract": "joint_mask_positions, geo_only_mask_positions, geometry_input_mask, and geometry_target_mask are specified below; no legacy mask_positions field is valid."
  },
  "serialization": {
    "primary_record_store": "LMDB value encoded only by the non-executable p1_pcqm_geometry_payload_format_contract/v2; pickle and any legacy v1 payload fallback are forbidden",
    "canonical_hash_serialization": "UTF-8 canonical JSON with sorted keys, compact separators, and no diagnostic source strings",
    "hash_algorithm": "sha256",
    "all_sha256_values": "lowercase 64-hex",
    "unknown_fields": "forbidden in every logical record, membership row, reject-ledger row, and smoke descriptor"
  },
  "scalar_types": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "type": [
        "string",
        "null"
      ],
      "string_pattern_when_present": "^[0-9a-f]{64}$"
    },
    "nonnegative_int": {
      "type": "integer",
      "minimum": 0
    },
    "positive_int": {
      "type": "integer",
      "minimum": 1
    },
    "storage_key": {
      "type": "string",
      "pattern": "^[0-9]{9}$"
    },
    "member_id": {
      "type": "string",
      "pattern": "^ogb_pcqm4mv2_train_row_index:[0-9]+$"
    }
  },
