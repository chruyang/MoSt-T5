        ],
        "required_values": {
          "coordinates_dtype": "float32",
          "coordinates_order": "C",
          "e3fp_dtype": "int32",
          "e3fp_order": "C",
          "model_to_source_atom_index_dtype": "int32",
          "motif_atom_indices_dtype": "int32"
        },
        "value_constraints": [
          "coordinates_shape equals [model_atom_count, 3]",
          "e3fp_shape equals [model_atom_count, 4]",
