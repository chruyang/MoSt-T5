    "admitted_record.topology.motif_atom_indices_sha256": "sha256",
    "admitted_record.geometry.motif_geometry_valid": "array_contracts.motif_geometry_valid",
    "admitted_record.geometry.coordinates": "array_contracts.coordinates",
    "admitted_record.geometry.coordinates_sha256": "sha256",
    "admitted_record.geometry.e3fp": "array_contracts.e3fp",
    "admitted_record.geometry.e3fp_shape": {
      "type": "integer_array",
      "const_shape": [
        "model_atom_count",
        4
      ]
    },
    "admitted_record.geometry.e3fp_params_sha256": "sha256",
    "admitted_record.geometry.e3fp_sha256": "sha256",
    "membership_row.member_id": "member_id",
    "membership_row.sdf_record_index": "nonnegative_int",
    "membership_row.official_csv_row_index": "nonnegative_int",
    "membership_row.selected_ordinal_set_sha256": "sha256",
    "membership_row.source_address_sha256": "sha256",
    "membership_row.record_content_sha256": "sha256_or_null_by_disposition",
    "reject_ledger_row.member_id": "member_id",
    "reject_ledger_row.sdf_record_index": "nonnegative_int",
    "reject_ledger_row.official_csv_row_index": "nonnegative_int",
    "reject_ledger_row.selected_ordinal_set_sha256": "sha256",
    "reject_ledger_row.source_address_sha256": "sha256",
    "reject_ledger_row.source_mol_identity_sha256": "nullable_sha256",
    "reject_ledger_row.geometry_mol_identity_sha256": "nullable_sha256",
    "reject_ledger_row.diagnostic_code": {
      "type": "string",
      "enum_source": "closed_reject_diagnostic_codes"
    },
    "reject_ledger_row.detail_sha256": "sha256"
  },
  "array_contracts": {
    "model_to_source_atom_index": {
      "dtype": "int32",
      "shape": [
        "model_atom_count"
      ],
      "layout": "C",
      "value_constraints": [
        "each value is in [0, source_atom_count)",
        "values are unique and strictly ascending",
        "every value is read from a surviving pre-RemoveHs _r1_source_atom_index tag; inferred compacted indices or offsets are forbidden"
      ]
    },
    "coordinates": {
      "dtype": "float32",
      "shape": [
        "model_atom_count",
        3
      ],
      "layout": "C",
      "value_constraints": [
        "every value is finite",
        "coordinates are copied from conformer 0 of the same post-projection geometry_mol",
        "no generated conformer, optimization, alignment, or undeclared coordinate transform"
      ]
    },
    "e3fp": {
      "dtype": "int32",
      "shape": [
        "model_atom_count",
        4
      ],
      "layout": "C",
      "value_constraints": [
        "every value is an integer in [-1, 4095]",
        "no row is [-1, -1, -1, -1]",
        "shell positions are populated from E3FP shell.center_atom and shell.radius"
      ]
    },
    "motif_atom_indices": {
      "dtype": "int32",
      "shape": [
        "motif_count",
        "variable_nonempty_length"
      ],
      "layout": "C_per_inner_array",
      "value_constraints": [
        "each inner array is strictly ascending and nonempty",
        "all values are in [0, model_atom_count)",
        "groups are pairwise disjoint and their union is exactly range(model_atom_count)"
      ]
    },
    "motif_geometry_valid": {
      "dtype": "bool",
      "shape": [
        "motif_count"
      ],
      "layout": "C",
      "value_constraints": [
        "every value is true for an admitted bounded-geometry-sidecar record"
      ]
    },
    "array_metadata": {
      "coordinates_dtype": "float32",
      "coordinates_shape": [
        "model_atom_count",
        3
      ],
      "coordinates_order": "C",
      "e3fp_dtype": "int32",
      "e3fp_shape": [
        "model_atom_count",
        4
      ],
      "e3fp_order": "C",
      "model_to_source_atom_index_dtype": "int32",
      "motif_atom_indices_dtype": "int32",
      "validation_rule": "The sidecar validator compares this metadata with the actual native arrays; it must not trust the declaration alone."
    }
  },
  "future_tokenizer_bound_record_requirements": {
    "status": "design_constraint_only_not_present_in_this_geometry_only_schema",
    "future_record_schema_version": "most-t5-r1/p1-pcqm-tokenizer-bound-record/v1",
    "admission_preconditions": [
      "A separately frozen tokenizer contract and id_to_token mapping exist.",
      "Every record binds their exact SHA-256 values and is validated against the immutable p1_record_schema lock.",
      "The R1 release manifest independently records a positive P1 admission decision."
    ],
    "required_fields": [
      "tokenizer_contract_sha256",
      "id_to_token_sha256",
      "full_input_ids",
      "unmasked_input_ids",
      "motif_ordinal_to_unmasked_token_index",
      "token_geometry_valid_mask",
      "joint_mask_positions",
      "geo_only_mask_positions",
      "geometry_input_mask",
      "geometry_target_mask"
    ],
    "array_contracts": {
      "full_input_ids": {
        "dtype": "int32",
        "shape": [
          "full_sequence_length"
        ],
        "layout": "C",
        "meaning": "Frozen complete P1 token sequence; its position domain is declared and linked to the unmasked domain by an explicit immutable index map."
      },
      "unmasked_input_ids": {
        "dtype": "int32",
        "shape": [
          "unmasked_sequence_length"
        ],
        "layout": "C",
        "meaning": "Frozen uncorrupted token sequence whose positions are the canonical domain for motif-to-token and all V1 mask arrays."
      },
      "full_to_unmasked_token_index": {
        "dtype": "int32",
        "shape": [
          "full_sequence_length"
        ],
        "layout": "C",
        "required": true,
        "value_constraints": [
          "each value is either -1 for a full-only special position or an in-range unmasked token position",
          "the mapping is explicit; no position correspondence may be inferred from re-tokenization or token-string equality"
        ]
      },
      "motif_ordinal_to_unmasked_token_index": {
        "dtype": "int32",
        "shape": [
          "motif_count"
        ],
        "layout": "C",
        "value_constraints": [
          "each value is unique and names an in-range non-special unmasked_input_ids position"
        ]
      },
      "token_geometry_valid_mask": {
        "dtype": "bool",
        "shape": [
          "unmasked_sequence_length"
        ],
        "layout": "C",
        "value_constraints": [
          "at motif_ordinal_to_unmasked_token_index[j], value equals motif_geometry_valid[j]",
          "full-only and special positions are never a geometry target"
        ]
      },
      "joint_mask_positions": {
        "dtype": "bool",
        "shape": [
          "unmasked_sequence_length"
        ],
        "layout": "C",
        "meaning": "Positions jointly corrupted for 2D/token reconstruction and geometry input corruption; V1 does not use them as an MSE target."
      },
      "geo_only_mask_positions": {
        "dtype": "bool",
        "shape": [
          "unmasked_sequence_length"
        ],
        "layout": "C",
        "meaning": "Positions whose geometry channel alone is corrupted and which may contribute to V1 geometric self-distillation."
      },
      "geometry_input_mask": {
        "dtype": "bool",
        "shape": [
          "unmasked_sequence_length"
        ],
        "layout": "C",
        "required_value": "joint_mask_positions OR geo_only_mask_positions"
      },
      "geometry_target_mask": {
        "dtype": "bool",
        "shape": [
          "unmasked_sequence_length"
        ],
        "layout": "C",
        "required_value": "geo_only_mask_positions AND token_geometry_valid_mask"
      }
    },
    "v1_mask_invariants": [
      "joint_mask_positions and geo_only_mask_positions are disjoint.",
      "geometry_input_mask equals elementwise OR(joint_mask_positions, geo_only_mask_positions).",
      "geometry_target_mask equals elementwise AND(geo_only_mask_positions, token_geometry_valid_mask).",
      "joint_mask_positions must not be silently included in geometry_target_mask under V1.",
      "If geometry_target_mask has zero true positions in a batch, MSE is skipped and no zero-vector substitute is created.",
      "The legacy field name mask_positions and its legacy semantics are forbidden."
    ],
    "not_yet_permitted": [
      "fabricating tokenizer_contract_sha256 or id_to_token_sha256 for this smoke",
      "adding full_input_ids, unmasked_input_ids, or any V1 mask array to a geometry-only pretokenizer record",
      "using a geometry-only pretokenizer record in a P1 dataloader or loss computation"
    ]
  },
