    "admitted_record.identity.official_strict_smiles_sha256": "sha256",
    "admitted_record.identity.canonical_connectivity_sha256": "sha256",
    "admitted_record.identity.identity_spec_sha256": "sha256",
    "admitted_record.identity.rdkit_version": {
      "type": "string",
      "min_length": 1
    },
